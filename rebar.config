%% rebar3 3.14+ 已移除内置 pc 插件,须显式声明后 port_specs/artifacts 才生效。
%% (老版本 rebar2 内置支持 port_specs,忽略未知配置项,不受影响。)
{plugins, [pc]}.
{provider_hooks, [
    {pre, [
        {compile, {pc, compile}},
        {clean, {pc, clean}}
    ]}
]}.

{port_specs, [{"priv/eqqwry.so", ["c_src/*.c"]}]}.
{artifacts, ["priv/eqqwry.so"]}.

{port_env, [
    {"(linux|darwin)", "CFLAGS", "$CFLAGS -O2 -Wall -Wextra"},
    {"(linux|darwin)", "LDFLAGS", "$LDFLAGS -shared"}
]}.
